#!/usr/bin/env bash
set -euo pipefail

main() {
	if (($# < 1 || $# > 2)); then
		echo 'Usage: renew CONFIG [production|staging|activate]' >&2
		exit 2
	fi
	action=${2:-production}
	case $action in
	production | staging) mode=$action ;;
	activate) mode=production ;;
	*)
		echo 'Usage: renew CONFIG [production|staging|activate]' >&2
		exit 2
		;;
	esac
	((EUID == 0)) || fail 'run as root.'
	read_config "$1"
	check_commands
	exec 9>"/run/lock/serverfiles-certificate-$id.lock"
	flock -n 9 || fail 'another run for this certificate is in progress.'

	acme_dir=$state_directory/$mode
	pending_file=$acme_dir/pending-activation
	secure_directory "$state_directory" 0700
	secure_directory "$acme_dir" 0700
	if [[ $mode == production ]]; then
		prepare_install_directory
		if [[ $action == activate ]]; then
			activate_pending
			return
		fi
		if [[ -f $pending_file ]]; then
			activate_pending defer
			if [[ -f $pending_file ]] &&
				validate_pair "$directory/current/$certificate_file" "$directory/current/$private_key_file" &&
				installed_metadata_matches; then
				activate_pending
				return
			fi
		fi
		server=https://acme-v02.api.letsencrypt.org/directory
	else
		server=https://acme-staging-v02.api.letsencrypt.org/directory
	fi
	[[ -f $contact_email_file && -r $contact_email_file ]] || fail 'ContactEmailFile must be a readable file with one ACME contact address.'
	email=$(cat "$contact_email_file") || fail 'cannot read ContactEmailFile.'
	[[ $email =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || fail 'ContactEmailFile must contain one valid ACME contact address.'
	podman secret inspect "$dns_secret" >/dev/null 2>&1 || fail 'the configured root Podman DNS secret does not exist.'
	issue_certificate
	local source_name=${domains[0]}
	local source_leaf=$acme_dir/certificates/$source_name.crt
	local source_issuer=$acme_dir/certificates/$source_name.issuer.crt
	local source_key=$acme_dir/certificates/$source_name.key
	[[ -s $source_leaf && -s $source_issuer && -s $source_key ]] || fail 'ACME client did not provide a certificate, issuer chain, and private key.'
	local source_cert=$acme_dir/$source_name.fullchain.crt
	install -m 0600 /dev/null "$source_cert"
	cat "$source_leaf" "$source_issuer" >"$source_cert"
	validate_pair "$source_cert" "$source_key" || fail 'certificate DNS SANs, trust, validity, or private key do not match the declaration.'
	if [[ $mode == staging ]]; then
		echo "ACME $id staging: validated certificate and private key; installed files and services were not changed."
		return
	fi
	if [[ -f $directory/current/$certificate_file && -f $directory/current/$private_key_file ]] &&
		cmp -s "$source_cert" "$directory/current/$certificate_file" &&
		cmp -s "$source_key" "$directory/current/$private_key_file" &&
		installed_metadata_matches; then
		activate_pending
		echo "ACME $id production: certificate, private key, and permissions are unchanged."
		return
	fi
	publish_pair "$source_cert" "$source_key"
	if [[ -n $restart_unit ]]; then
		activate_pending
	else
		rm -f "$pending_file"
	fi
	echo "ACME $id production: installed a verified certificate pair."
}

fail() {
	echo "ACME${id:+ $id} $mode: $1" >&2
	exit 1
}

safe_path() {
	[[ $1 =~ ^/[A-Za-z0-9._/-]+$ && $1 == /*/* && $1 != */ && $1 != *//* &&
		$1 != */./* && $1 != */../* && $1 != */. && $1 != */.. ]] || return 1
	case $1 in
	/proc/* | /sys/* | /dev/* | /bin/* | /sbin/* | /usr/* | /boot/*) return 1 ;;
	esac
	return 0
}

safe_domain() {
	local domain=$1 label
	[[ ${#domain} -le 253 && $domain == *.* && $domain != *..* && $domain != .* && $domain != *. &&
		${domain##*.} =~ ^[a-z]([a-z0-9-]*[a-z0-9])?$ ]] || return 1
	local -a labels
	IFS=. read -r -a labels <<<"$domain"
	for label in "${labels[@]}"; do
		[[ ${#label} -le 63 && $label =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || return 1
	done
}

read_config() {
	local config=$1 line key value required
	local resolver_pattern='^([A-Za-z0-9][A-Za-z0-9.-]*:[0-9]+|\[[0-9A-Fa-f:]+\]:[0-9]+)$'
	local -A seen=() domain_seen=() resolver_seen=()
	[[ -f $config && -r $config ]] || fail 'CONFIG must be a readable rendered certificate configuration.'
	while IFS= read -r line || [[ -n $line ]]; do
		[[ $line == *$'\t'* ]] || fail 'configuration entries must be Key<TAB>Value lines.'
		key=${line%%$'\t'*}
		[[ $key =~ ^[A-Za-z]+$ ]] || fail 'configuration keys must contain only letters.'
		value=${line#*$'\t'}
		[[ -n $value && $value != *$'\t'* && ! $value =~ [[:cntrl:]] ]] || fail 'configuration values must be nonempty and contain no control characters.'
		if [[ $key != Domain && $key != DNSResolver ]]; then
			[[ ! -v seen[$key] ]] || fail 'configuration has a duplicate scalar key.'
			seen[$key]=yes
		fi
		case $key in
		Id)
			[[ ${#value} -le 63 && $value =~ ^[a-z0-9][a-z0-9-]*$ ]] || fail 'Id must contain at most 63 lowercase letters, digits, and hyphens.'
			id=$value
			;;
		ContactEmailFile)
			safe_path "$value" || fail 'ContactEmailFile must be a safe absolute file path.'
			contact_email_file=$value
			;;
		DNSProvider) [[ $value == cloudflare ]] || fail 'DNSProvider must be cloudflare.' ;;
		DNSCredential)
			[[ $value =~ ^podman-secret:[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || fail 'DNSCredential must name a Podman secret.'
			dns_secret=${value#podman-secret:}
			;;
		Domain)
			safe_domain "$value" || fail 'Domain must be a lowercase public DNS name without a wildcard.'
			[[ ! -v domain_seen[$value] ]] || fail 'configuration has a duplicate Domain.'
			domain_seen[$value]=yes
			domains+=("$value")
			;;
		DNSResolver)
			[[ $value =~ $resolver_pattern ]] || fail 'DNSResolver must be a DNS name or IP address with an explicit port.'
			[[ ! -v resolver_seen[$value] ]] || fail 'configuration has a duplicate DNSResolver.'
			resolver_seen[$value]=yes
			resolvers+=("$value")
			;;
		RenewDays | MinimumValidity)
			[[ $value =~ ^[1-9][0-9]*$ && ${#value} -le 10 ]] || fail 'renewal and validity values must be positive integers.'
			if [[ $key == RenewDays ]]; then
				((value <= 999999)) || fail 'RenewDays must be at most 999999.'
				renew_days=$value
			else
				((value <= 2147483647)) || fail 'MinimumValidity must be at most 2147483647 seconds.'
				minimum_validity=$value
			fi
			;;
		StateDirectory)
			safe_path "$value" || fail 'StateDirectory must be a safe absolute directory path.'
			state_directory=$value
			;;
		Directory)
			safe_path "$value" || fail 'Directory must be a safe absolute directory path.'
			directory=$value
			;;
		CertificateFile | PrivateKeyFile)
			[[ $value =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || fail 'certificate filenames must be simple names without path separators.'
			if [[ $key == CertificateFile ]]; then certificate_file=$value; else private_key_file=$value; fi
			;;
		User | Group)
			[[ $value =~ ^(0|[1-9][0-9]*)$ && ${#value} -le 10 ]] || fail 'User and Group must be numeric IDs.'
			((value <= 4294967294)) || fail 'User and Group must be at most 4294967294.'
			if [[ $key == User ]]; then owner=$value; else group=$value; fi
			;;
		CertificateMode | PrivateKeyMode)
			if [[ $key == CertificateMode ]]; then
				case $value in 0400 | 0440 | 0444 | 0600 | 0640 | 0644) ;; *) fail 'CertificateMode must be 0400, 0440, 0444, 0600, 0640, or 0644.' ;; esac
				certificate_mode=$value
			else
				case $value in 0400 | 0600) ;; *) fail 'PrivateKeyMode must be 0400 or 0600.' ;; esac
				private_key_mode=$value
			fi
			;;
		RestartUnit)
			[[ $value =~ ^[A-Za-z0-9][A-Za-z0-9_.@:-]*\.service$ ]] || fail 'RestartUnit must name one service unit.'
			restart_unit=$value
			;;
		*) fail 'configuration contains an unknown key.' ;;
		esac
	done <"$config"
	for required in Id ContactEmailFile DNSProvider DNSCredential RenewDays MinimumValidity StateDirectory Directory CertificateFile PrivateKeyFile User Group; do
		[[ -v seen[$required] ]] || fail "configuration is missing $required."
	done
	((${#domains[@]} > 0)) || fail 'configuration must include at least one Domain.'
	[[ $certificate_file != "$private_key_file" ]] || fail 'CertificateFile and PrivateKeyFile must be different.'
	[[ $directory != "$state_directory" && $directory != "$state_directory/"* &&
		$state_directory != "$directory/"* ]] || fail 'Directory and StateDirectory must not overlap.'
}

check_commands() {
	local command_name
	for command_name in podman openssl flock install cat cmp sha256sum sort mktemp chmod mv ln rm readlink date stat; do
		command -v "$command_name" >/dev/null || fail "$command_name is required."
	done
	if [[ $mode == production && -n $restart_unit ]]; then
		command -v systemctl >/dev/null || fail 'systemctl is required when RestartUnit is set.'
	fi
}

secure_directory() {
	local target=$1 final_mode=$2 current='' part identity permissions
	[[ $target == /var/lib/* ]] || fail 'mutable certificate paths must be under /var/lib/.'
	local parts=()
	IFS=/ read -r -a parts <<<"${target#/}"
	for part in "${parts[@]}"; do
		current+=/$part
		[[ ! -L $current ]] || fail 'certificate paths must not contain symlink components.'
		if [[ $current == "$target" ]]; then
			install -d -o 0 -g 0 -m "$final_mode" "$current"
			return
		fi
		if [[ ! -e $current ]]; then
			install -d -o 0 -g 0 -m 0755 "$current"
		fi
		[[ -d $current ]] || fail 'a certificate path ancestor is not a directory.'
		IFS=: read -r identity permissions < <(stat -c '%u:%a' "$current")
		if [[ $identity != 0 ]] || (((8#$permissions & 0022) != 0)); then
			fail 'certificate path ancestors must be root-owned and not group- or other-writable.'
		fi
	done
}

installed_metadata_matches() {
	[[ $(stat -c '%u:%g:%a' "$directory/current/$certificate_file") == "$owner:$group:${certificate_mode#0}" &&
	$(stat -c '%u:%g:%a' "$directory/current/$private_key_file") == "$owner:$group:${private_key_mode#0}" ]]
}

deployment_in_progress() {
	exec 8>/run/lock/serverfiles-certificate-deployment.lock
	if flock -n 8; then
		flock -u 8
		exec 8>&-
		return 1
	fi
	exec 8>&-
	return 0
}

# Publication finishes before any consumer restarts during a multi-certificate deployment.
# Durable activation records let the next timer recover an interrupted deployment.
activate_pending() {
	[[ -f $pending_file ]] || return 0
	local links=() current_link
	mapfile -t links <"$pending_file"
	[[ ${#links[@]} == 2 && (-z ${links[0]} || ${links[0]} =~ ^releases/[A-Za-z0-9._-]+$) &&
		${links[1]} =~ ^releases/[A-Za-z0-9._-]+$ ]] || fail 'pending activation record is invalid.'
	current_link=$(readlink "$directory/current") || current_link=
	if [[ $current_link == "${links[0]}" ]]; then
		rm -f "$pending_file"
		return 0
	fi
	[[ $current_link == "${links[1]}" ]] || fail 'pending activation does not match the current release.'
	previous_link=${links[0]}
	next_link=$directory/.current-$$
	published=yes
	[[ ${1:-} != defer ]] || return 0
	if deployment_in_progress; then
		echo "ACME $id production: consumer activation deferred until deployment finishes certificate publication."
		return 0
	fi
	validate_pair "$directory/current/$certificate_file" "$directory/current/$private_key_file" || fail 'pending certificate pair failed verification.'
	if [[ -n $restart_unit ]] && systemctl is-active --quiet "$restart_unit"; then
		restart_attempted=yes
		systemctl restart "$restart_unit" || fail 'service restart failed after certificate publication.'
	fi
	rm -f "$pending_file"
	published=no
	pending_created=no
	restart_attempted=no
	previous_link=$(readlink "$directory/current")
}

prepare_install_directory() {
	secure_directory "$directory" 0755
	secure_directory "$directory/releases" 0755
	[[ ! -e $directory/current || -L $directory/current ]] || fail 'current must be a symlink to a certificate release.'
	[[ ! -L $directory/current || -d $directory/current ]] || fail 'current points to a missing certificate release.'
	if [[ -L $directory/current ]]; then
		previous_link=$(readlink "$directory/current") || fail 'cannot read the current certificate link.'
	fi
}

issue_certificate() {
	local domain resolver
	local -a lego_flags=(
		--path /acme
		--server "$server"
		--email "$email"
		--accept-tos
		--no-bundle
		--dns cloudflare
		--force-cert-domains
		--renew-days "$renew_days"
	)
	for resolver in "${resolvers[@]}"; do lego_flags+=(--dns.resolvers "$resolver"); done
	for domain in "${domains[@]}"; do lego_flags+=(--domains "$domain"); done
	[[ $mode != staging ]] || lego_flags+=(--renew-force)
	# Provider errors can contain credentials, so do not send this output to the journal.
	if ! podman run --rm --pull=missing --network=host \
		--secret "$dns_secret,type=mount,target=cf-token" \
		--env CF_DNS_API_TOKEN_FILE=/run/secrets/cf-token \
		--volume "$acme_dir:/acme:Z" \
		"$image" run "${lego_flags[@]}" >/dev/null 2>&1; then
		fail 'certificate issuance or renewal failed.'
	fi
}

validate_pair() {
	local cert=$1 key=$2 san_output san cert_pub key_pub actual_sans expected_sans
	local -a sans=()
	openssl x509 -in "$cert" -noout -checkend "$minimum_validity" >/dev/null 2>&1 || return 1
	san_output=$(openssl x509 -in "$cert" -noout -ext subjectAltName 2>/dev/null) || return 1
	[[ $san_output == *$'\n'* ]] || return 1
	san_output=${san_output#*$'\n'}
	while IFS= read -r san; do
		san=${san#"${san%%[![:space:]]*}"}
		san=${san%"${san##*[![:space:]]}"}
		[[ $san == DNS:* ]] || return 1
		sans+=("${san,,}")
	done <<<"${san_output//,/$'\n'}"
	actual_sans=$(printf '%s\n' "${sans[@]}" | LC_ALL=C sort) || return 1
	expected_sans=$(printf 'dns:%s\n' "${domains[@]}" | LC_ALL=C sort) || return 1
	[[ $actual_sans == "$expected_sans" ]] || return 1
	cert_pub=$(openssl x509 -in "$cert" -pubkey -noout 2>/dev/null | openssl pkey -pubin -outform DER 2>/dev/null | sha256sum) || return 1
	key_pub=$(openssl pkey -in "$key" -pubout -outform DER 2>/dev/null | sha256sum) || return 1
	[[ $cert_pub == "$key_pub" ]] || return 1
	if [[ $mode == production ]]; then
		openssl verify -CAfile /etc/ssl/certs/ca-certificates.crt -untrusted "$cert" "$cert" >/dev/null 2>&1 || return 1
	fi
}

publish_pair() {
	local source_cert=$1 source_key=$2 release_name
	incoming=$(mktemp -d "$directory/releases/.incoming.XXXXXXXX")
	next_link=$directory/.current-$$
	install -o "$owner" -g "$group" -m "$certificate_mode" "$source_cert" "$incoming/$certificate_file"
	install -o "$owner" -g "$group" -m "$private_key_mode" "$source_key" "$incoming/$private_key_file"
	validate_pair "$incoming/$certificate_file" "$incoming/$private_key_file" || fail 'prepared certificate pair failed verification.'
	chmod 0755 "$incoming"
	release_name=$(date -u +%Y%m%dT%H%M%SZ)-$$
	mv -T "$incoming" "$directory/releases/$release_name"
	incoming=
	if [[ -n $restart_unit ]]; then
		pending_temp=$(mktemp "$acme_dir/.activation.XXXXXXXX")
		printf '%s\n%s\n' "$previous_link" "releases/$release_name" >"$pending_temp"
		mv -Tf "$pending_temp" "$pending_file"
		pending_temp=
		pending_created=yes
	fi
	ln -s "releases/$release_name" "$next_link"
	published=yes
	mv -Tf "$next_link" "$directory/current"
}

restore_previous() {
	rm -f "$next_link" || return 1
	if [[ -n $previous_link ]]; then
		ln -s "$previous_link" "$next_link" || return 1
		mv -Tf "$next_link" "$directory/current" || return 1
	else
		rm -f "$directory/current" || return 1
	fi
}

on_exit() {
	local status=$?
	trap - EXIT
	set +e
	if ((status != 0)); then
		if [[ $published == yes ]]; then
			if restore_previous; then
				[[ -z $pending_file ]] || rm -f "$pending_file"
				if [[ -n $previous_link ]]; then
					echo "ACME $id $mode: failed after publication; restored the previous certificate pair." >&2
					if [[ $restart_attempted == yes ]]; then
						if systemctl restart "$restart_unit"; then
							echo "ACME $id $mode: service restarted with the previous certificate pair." >&2
						else
							echo "ACME $id $mode: previous certificate pair is restored, but service recovery restart failed." >&2
						fi
					fi
				else
					echo "ACME $id $mode: failed after publication; removed the new current link because no previous certificate pair existed. Service recovery is not guaranteed." >&2
				fi
			else
				echo "ACME $id $mode: failed after publication and could not restore the previous state; the new certificate pair may remain current. Service recovery is not guaranteed." >&2
			fi
		else
			if [[ $pending_created == yes ]]; then
				rm -f "$pending_file"
			fi
			echo "ACME${id:+ $id} $mode: failed before publication; installed certificate pair was not changed." >&2
		fi
		if [[ $mode == production && -n $directory && -n $certificate_file && -n $minimum_validity && -f $directory/current/$certificate_file ]] &&
			! openssl x509 -in "$directory/current/$certificate_file" -noout -checkend "$minimum_validity" >/dev/null 2>&1; then
			echo "ACME $id production: installed certificate does not meet MinimumValidity or cannot be read." >&2
		fi
	fi
	[[ -z $next_link ]] || rm -f "$next_link"
	[[ -z $incoming || ! -d $incoming ]] || rm -rf "$incoming"
	[[ -z $pending_temp ]] || rm -f "$pending_temp"
	exit "$status"
}

mode=production
action=production
pending_file=
pending_temp=
pending_created=no
id=
directory=
certificate_file=
minimum_validity=
certificate_mode=0644
private_key_mode=0400
restart_unit=
previous_link=
incoming=
next_link=
published=no
restart_attempted=no
domains=()
resolvers=()
image=docker.io/goacme/lego:v5.5.2@sha256:1944e8c36055beec47c7de6f15202b41128be75eea0ffa257f0c14d93c5155fd
trap on_exit EXIT
main "$@"
