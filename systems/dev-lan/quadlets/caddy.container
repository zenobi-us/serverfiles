[Unit]
Description=Caddy reverse proxy for dev.lan projects
After=podman.socket
Requires=podman.socket

[Container]
Image=docker.io/lucaslorentz/caddy-docker-proxy:2.12-alpine
ContainerName=caddy-proxy
Network=shared.network
PublishPort=80:80
PublishPort=443:443/tcp
PublishPort=443:443/udp
Volume=/run/podman/podman.sock:/var/run/docker.sock:ro
Volume=/var/lib/caddy/data:/data:Z
Volume=/var/lib/caddy/config:/config:Z
Environment=DOCKER_HOST=unix:///var/run/docker.sock
Environment=CADDY_INGRESS_NETWORKS=shared
Environment=CADDY_DOCKER_NO_SCOPE=true
User=0

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
