lan.zenobi.us:53 {
    bind 192.168.86.253
    errors
    file /etc/coredns/lan.zenobi.us.zone lan.zenobi.us
}

.:53 {
    bind 192.168.86.253
    errors
    # Preserve the SSH bootstrap name when DHCP sends all queries here.
    hosts {
        192.168.86.253 services.lan
        fallthrough
    }
    # Use independent public resolvers, not the host resolver or the LAN gateway.
    forward . 1.1.1.1 9.9.9.9
    cache 30
}
