$ORIGIN lan.zenobi.us.
$TTL 300
@ IN SOA ns1.lan.zenobi.us. hostmaster.lan.zenobi.us. (
    2026101501 ; serial: increment when records change
    3600       ; refresh
    600        ; retry
    604800     ; expire
    300        ; negative cache TTL
)
@ IN NS ns1.lan.zenobi.us.
ns1 IN A 192.168.86.253
authentik.services IN A 192.168.86.253
godoxy.services IN A 192.168.86.253
