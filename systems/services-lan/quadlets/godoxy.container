[Unit]
Description=GoDoxy reverse proxy and WebUI
ConditionPathExists=/var/lib/godoxy/enabled
Requires=authentik-server.service coredns.service
After=authentik-server.service coredns.service
After=network-online.target

[Container]
Image=ghcr.io/yusing/godoxy:v0.32.1@sha256:704a535bb098811bf6345b65325acaa3ef99b1a0dcdaad440c192cbb8e84cc76
ContainerName=godoxy
Network=host
User=1000:1000
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
Environment=GODOXY_OIDC_ISSUER_URL=https://authentik.services.lan.zenobi.us/application/o/godoxy/
Environment=GODOXY_OIDC_ALLOWED_GROUPS=godoxy-admins
Environment=GODOXY_OIDC_SCOPES=openid,profile,email,groups
Environment=GODOXY_API_ADDR=127.0.0.1:8888
Environment=GODOXY_API_JWT_SECURE=true
Secret=godoxy-oidc-client-id,type=env,target=GODOXY_OIDC_CLIENT_ID
Secret=godoxy-oidc-client-secret,type=env,target=GODOXY_OIDC_CLIENT_SECRET
Secret=godoxy-api-jwt-secret,type=env,target=GODOXY_API_JWT_SECRET
Volume=/var/lib/godoxy/config:/app/config:Z
Volume=/etc/serverfiles/config/godoxy/config.yml:/app/config/config.yml:ro,Z
Volume=/etc/serverfiles/config/godoxy/services.yml:/app/config/services.yml:ro,Z
Volume=/var/lib/godoxy/logs:/app/logs:Z
Volume=/var/lib/godoxy/error_pages:/app/error_pages:Z
Volume=/var/lib/godoxy/data:/app/data:Z
Volume=/var/lib/godoxy/certs:/app/certs:Z

[Service]
ExecStartPre=/usr/bin/bash /etc/serverfiles/config/godoxy/preflight.sh
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
