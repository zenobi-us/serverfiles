[Unit]
Description=CoreDNS private LAN resolver
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/coredns/coredns:1.13.1@sha256:9b9128672209474da07c91439bf15ed704ae05ad918dd6454e5b6ae14e35fee6
ContainerName=coredns
Exec=-conf /etc/coredns/Corefile
Network=host
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
Volume=/etc/serverfiles/config/coredns:/etc/coredns:ro,Z

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
