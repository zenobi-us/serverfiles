#!/usr/bin/env bash
#MISE description="Create a machine tree"
#USAGE arg "<host>" help="Fully qualified host name"
set -euo pipefail

host=${usage_host:?}
[[ $host =~ ^[a-z0-9][a-z0-9.-]*[a-z0-9]$ && $host == *.* && $host != *..* && $host != *.-* && $host != *-.* ]] || {
	echo "Invalid host name: $host" >&2
	exit 1
}

machine=${host//./-}
dir="systems/$machine"
[[ ! -e $dir ]] || {
	echo "Machine already exists: $machine" >&2
	exit 1
}

mkdir -p "$dir"/{quadlets,config}
printf 'host = "%s"\nuser = "core"\n' "$host" >"$dir/machine.toml"
printf '# Add generated systemd service names, one per line.\n' >"$dir/units"
printf 'Created %s\n' "$dir"
