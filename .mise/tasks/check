#!/usr/bin/env bash
#MISE description="Check repository files"
set -euo pipefail

command -v git >/dev/null
command -v ssh >/dev/null
command -v systemd-analyze >/dev/null

scripts=(bin/* .mise/tasks/check .mise/tasks/container/* .mise/tasks/machine/* systems/common/config/certificates/renew systems/services-lan/config/godoxy/preflight.sh tests/certificates tests/helpers/*)
shellcheck "${scripts[@]}"
shfmt -d "${scripts[@]}"

for unit in systemd/*; do
	SYSTEMD_UNIT_PATH="$PWD/systemd" systemd-analyze cat-config "$(basename "$unit")" >/dev/null
done

for machine in systems/*; do
	[[ -d $machine || $(basename "$machine") == common ]] || continue
	[[ $(basename "$machine") == common ]] && continue
	[[ -f $machine/machine.toml ]] || {
		echo "Missing $machine/machine.toml" >&2
		exit 1
	}
	bin/render "$(basename "$machine")" >/dev/null
	if [[ -d .rendered/$(basename "$machine")/systemd ]]; then
		for unit in ".rendered/$(basename "$machine")"/systemd/*; do
			SYSTEMD_UNIT_PATH="$PWD/.rendered/$(basename "$machine")/systemd" systemd-analyze cat-config "$(basename "$unit")" >/dev/null
		done
	fi
done

tests/certificates
