#!/usr/bin/env bash
#MISE description="Check repository files"
set -euo pipefail

command -v git >/dev/null
command -v ssh >/dev/null
command -v systemd-analyze >/dev/null

shellcheck bin/* .mise/tasks/check .mise/tasks/container/* .mise/tasks/machine/*
shfmt -d bin/* .mise/tasks/check .mise/tasks/container/* .mise/tasks/machine/*

for unit in systemd/*; do
	SYSTEMD_UNIT_PATH="$PWD/systemd" systemd-analyze cat-config "$(basename "$unit")" >/dev/null
done
for script in systems/services-lan/config/acme/renew systems/services-lan/config/godoxy/preflight.sh; do
	shellcheck "$script"
	shfmt -d "$script"
done

for machine in systems/*; do
	[[ -d $machine || $(basename "$machine") == common ]] || continue
	[[ $(basename "$machine") == common ]] && continue
	[[ -f $machine/machine.toml ]] || {
		echo "Missing $machine/machine.toml" >&2
		exit 1
	}
	bin/render "$(basename "$machine")" >/dev/null
	if [[ -d $machine/systemd ]]; then
		for unit in "$machine"/systemd/*; do
			SYSTEMD_UNIT_PATH="$PWD/$machine/systemd" systemd-analyze cat-config "$(basename "$unit")" >/dev/null
		done
	fi
done
