#!/usr/bin/env bash
#MISE description="Provision a machine from origin/main"
#USAGE arg "<machine>" help="Machine name"
set -euo pipefail

machine=${usage_machine:?}
root=$(git rev-parse --show-toplevel)
cd "$root"

git fetch origin main

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

git archive origin/main | tar -x -C "$tmp"
[[ -f $tmp/systems/$machine/machine.toml ]] || {
	echo "Unknown machine in origin/main: $machine" >&2
	exit 1
}

host=$(awk -F ' *= *' '$1 == "host" { gsub(/["[:space:]]/, "", $2); print $2 }' "$tmp/systems/$machine/machine.toml")
user=$(awk -F ' *= *' '$1 == "user" { gsub(/["[:space:]]/, "", $2); print $2 }' "$tmp/systems/$machine/machine.toml")
[[ -n $host && -n $user ]] || {
	echo "machine.toml must define host and user" >&2
	exit 1
}

"$tmp/bin/render" "$machine" "$tmp/release" >/dev/null
remote_tmp="/tmp/serverfiles-${machine}-$$"

# The remote path is generated locally and contains no user input.
# shellcheck disable=SC2029
tar -C "$tmp/release" -cf - . | ssh "$user@$host" "rm -rf '$remote_tmp' && mkdir -p '$remote_tmp' && tar -xf - -C '$remote_tmp'"
scp "$tmp/bin/reconcile" "$user@$host:$remote_tmp/reconcile"
# shellcheck disable=SC2029
ssh -t "$user@$host" "sudo bash '$remote_tmp/reconcile' '$remote_tmp'; status=\$?; rm -rf '$remote_tmp'; exit \$status"
