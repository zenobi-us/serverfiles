#!/usr/bin/env bash
#MISE description="Create a machine tree"
#USAGE arg "<machine>" help="Machine name"
set -euo pipefail

machine=${usage_machine:?}
[[ $machine =~ ^[a-z0-9][a-z0-9-]*$ ]] || {
	echo "Invalid machine name: $machine" >&2
	exit 1
}

dir="systems/$machine"
[[ ! -e $dir ]] || {
	echo "Machine already exists: $machine" >&2
	exit 1
}

mkdir -p "$dir"/{quadlets,config}
printf 'host = "%s.lan"\nuser = "core"\n' "$machine" >"$dir/machine.toml"
printf '# Add generated systemd service names, one per line.\n' >"$dir/units"
printf 'Created %s\n' "$dir"
